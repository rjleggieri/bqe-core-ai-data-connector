# MOCK is the safe default. LIVE requires both BQE_MODE=LIVE and BQE_ENABLE_LIVE=YES.
BQE_MODE=MOCK
BQE_ENABLE_LIVE=NO

# Native application (Authorization Code + PKCE; no client secret).
BQE_CLIENT_ID=
BQE_REDIRECT_URI=http://127.0.0.1:8765/callback
BQE_SCOPES=read:core
BQE_AUTHORITY=https://api-identity.bqecore.com/idp

# Populated from the OAuth token response; do not guess or hard-code it.
BQE_API_BASE_URL=

# Access tokens are stored in Windows Credential Manager. Native Apps do not
# receive refresh tokens, so interactive sign-in is required after expiration.
BQE_DB_PATH=data/bqe_reporting.sqlite3
BQE_UTC_OFFSET=-04:00
BQE_LOG_LEVEL=INFO
